{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SonarQube whitelist",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects", "mounts"],
  "properties": {
    "mounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "container"],
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "container": { "type": "string", "minLength": 1 }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostPath"],
        "properties": {
          "hostPath": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "projectKey": { "type": "string" }
        }
      }
    }
  }
}
