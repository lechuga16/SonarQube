# --- SonarQube Web ---
# Puerto donde escucha SonarQube en el host (por defecto 9000)
SONARQUBE_PORT=9000

# --- DB (PostgreSQL) ---
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar
POSTGRES_DB=sonar

# --- JDBC SonarQube ---
# URL de conexión JDBC al servicio de Postgres dentro del compose
SONAR_JDBC_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
SONAR_JDBC_USERNAME=${POSTGRES_USER}
SONAR_JDBC_PASSWORD=${POSTGRES_PASSWORD}

# --- Token de SonarQube (généralo en http://localhost:9000 -> My Account -> Security)
# No incluyas tokens reales en este archivo.
SONAR_TOKEN=

# --- Host de SonarQube usado por scripts/scan ---
SONAR_HOST_URL=http://localhost:9000

# --- Ajustes del scanner (opcionales) ---
# Paralelismo al escanear proyectos (1 = secuencial)
SCAN_PARALLELISM=1
# Timeout total (segundos) esperando a SonarQube
SONAR_WAIT_TIMEOUT_SECONDS=300
# Intervalo de espera entre checks (segundos)
SONAR_WAIT_INTERVAL_SECONDS=5
